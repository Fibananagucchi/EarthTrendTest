# Trend Detective — environment variables
# Copy to .env and fill in:  cp .env.example .env

# ── Google Earth Engine (required for live NASA data) ─────────────
# A Google Cloud project with the Earth Engine API enabled.
# Run `python auth.py` once to log in on this machine.
GEE_PROJECT=your-google-cloud-project-id

# Optional, for servers (e.g. Streamlit Cloud): a service-account key as one JSON string.
# GEE_SERVICE_ACCOUNT_JSON={"type": "service_account", ...}

# ── Groq LLM (optional) ─────────────────────────────────────────
# Free key at https://console.groq.com — enables AI-written trend summaries.
# Without it the app writes template summaries from the same statistics.
GROQ_API_KEY=your-groq-api-key-here
# GROQ_MODEL=llama-3.3-70b-versatile
